diff --git a/src/http/ngx_http_upstream.c b/src/http/ngx_http_upstream.c
--- a/src/http/ngx_http_upstream.c
+++ b/src/http/ngx_http_upstream.c
@@ -56,6 +56,10 @@ static ngx_int_t ngx_http_upstream_test_next(ngx_http_request_t *r,
 static ngx_int_t ngx_http_upstream_intercept_errors(ngx_http_request_t *r,
     ngx_http_upstream_t *u);
 static ngx_int_t ngx_http_upstream_test_connect(ngx_connection_t *c);
+#if (NGX_HAVE_EBPF)
+static void ngx_http_upstream_save_synack(ngx_http_request_t *r,
+    ngx_http_upstream_t *u);
+#endif
 static ngx_int_t ngx_http_upstream_process_headers(ngx_http_request_t *r,
     ngx_http_upstream_t *u);
 static ngx_int_t ngx_http_upstream_process_trailers(ngx_http_request_t *r,
@@ -1567,6 +1571,34 @@ ngx_http_upstream_check_broken_connection(ngx_http_request_t *r,
 }
 
 
+#if (NGX_HAVE_EBPF)
+static void
+ngx_http_upstream_save_synack(ngx_http_request_t *r, ngx_http_upstream_t *u)
+{
+    u_char                    *p;
+    ngx_connection_t          *c;
+    ngx_http_core_loc_conf_t  *clcf;
+
+    c = u->peer.connection;
+    clcf = ngx_http_get_module_loc_conf(r, ngx_http_core_module);
+    if (c == NULL || u->state == NULL || !clcf->tcp_save_synack) {
+        return;
+    }
+    ngx_connection_save_synack(c);
+    if (u->state->saved_synack.len || !c->saved_synack.len) {
+        return;
+    }
+    p = ngx_pnalloc(r->pool, c->saved_synack.len);
+    if (p == NULL) {
+        return; /* Optional metadata must not fail upstream traffic. */
+    }
+    ngx_memcpy(p, c->saved_synack.data, c->saved_synack.len);
+    u->state->saved_synack.data = p;
+    u->state->saved_synack.len = c->saved_synack.len;
+}
+#endif
+
+
 static void
 ngx_http_upstream_connect(ngx_http_request_t *r, ngx_http_upstream_t *u)
 {
@@ -1595,6 +1627,10 @@ ngx_http_upstream_connect(ngx_http_request_t *r, ngx_http_upstream_t *u)
     u->state->connect_time = (ngx_msec_t) -1;
     u->state->header_time = (ngx_msec_t) -1;
 
+#if (NGX_HAVE_EBPF)
