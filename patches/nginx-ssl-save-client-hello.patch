@@ -2145,6 +2145,9 @@ ngx_ssl_create_connection(ngx_ssl_t *ssl, ngx_connection_t *c, ngx_uint_t flags)
 #ifdef SSL_OP_NO_RENEGOTIATION
         SSL_set_options(sc->connection, SSL_OP_NO_RENEGOTIATION);
 #endif
+
+        /* ja4: keep the raw ClientHello */
+        SSL_set_msg_callback(sc->connection, ngx_ssl_ja4_msg_callback);
     }
 
     if (SSL_set_ex_data(sc->connection, ngx_ssl_connection_index, c) == 0) {
@@ -2158,6 +2161,43 @@ ngx_ssl_create_connection(ngx_ssl_t *ssl, ngx_connection_t *c, ngx_uint_t flags)
 }
 
 
+/* ja4: keeps a copy of the first ClientHello, the ja4 module parses it */
+
+void
+ngx_ssl_ja4_msg_callback(int write_p, int version, int content_type,
+    const void *buf, size_t len, ngx_ssl_conn_t *ssl_conn, void *arg)
+{
+    const u_char          *p;
+    ngx_connection_t      *c;
+    ngx_ssl_connection_t  *sc;
+
+    p = buf;
+
+    if (write_p
+        || content_type != SSL3_RT_HANDSHAKE
+        || len < 4
+        || p[0] != SSL3_MT_CLIENT_HELLO)
+    {
+        return;
+    }
+
+    c = ngx_ssl_get_connection(ssl_conn);
+    sc = c->ssl;
+
+    if (sc == NULL || sc->raw_client_hello) {
+        return;
+    }
+
+    sc->raw_client_hello = ngx_pnalloc(c->pool, len);
+    if (sc->raw_client_hello == NULL) {
+        return;
+    }
+
+    ngx_memcpy(sc->raw_client_hello, buf, len);
+    sc->raw_client_hello_len = len;
+}
+
+
 ngx_ssl_session_t *
 ngx_ssl_get_session(ngx_connection_t *c)
 {
