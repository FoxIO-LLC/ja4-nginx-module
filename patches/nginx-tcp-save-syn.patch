+#if (NGX_HAVE_TCP_SAVE_SYN)
+
+static ngx_inline ngx_uint_t
+ngx_tcp_save_syn_eligible(int type, ngx_uint_t quic, struct sockaddr *sa)
+{
+    if (type != SOCK_STREAM || quic) {
+        return 0;
+    }
+
+#if (NGX_HAVE_UNIX_DOMAIN)
+    if (sa != NULL && sa->sa_family == AF_UNIX) {
+        return 0;
+    }
+#endif
+
+    return 1;
+}
+
+void ngx_connection_save_syn(ngx_connection_t *c);
+
+#endif
+
 void ngx_reusable_connection(ngx_connection_t *c, ngx_uint_t reusable);
 
 #endif /* _NGX_CONNECTION_H_INCLUDED_ */

--- a/src/core/ngx_connection.c
+++ b/src/core/ngx_connection.c
@@ -870,6 +870,21 @@
         }
 #endif
 
+#if (NGX_HAVE_TCP_SAVE_SYN)
+        if (ngx_tcp_save_syn_eligible(ls[i].type, ls[i].quic, ls[i].sockaddr)) {
+            value = ls[i].save_syn ? 1 : 0;
+
+            if (setsockopt(ls[i].fd, IPPROTO_TCP, TCP_SAVE_SYN,
+                           (const void *) &value, sizeof(int))
+                == -1)
+            {
+                ngx_log_error(NGX_LOG_ALERT, cycle->log, ngx_socket_errno,
+                              "setsockopt(TCP_SAVE_SYN, %d) %V failed, ignored",
+                              value, &ls[i].addr_text);
+            }
+        }
+#endif
+
 #if 0
         if (1) {
             int tcp_nodelay = 1;
@@ -1269,6 +1284,43 @@
 }
 
 
+#if (NGX_HAVE_TCP_SAVE_SYN)
+
+#define NGX_TCP_SAVED_SYN_MAX  512
+
+void
+ngx_connection_save_syn(ngx_connection_t *c)
+{
+    u_char     buf[NGX_TCP_SAVED_SYN_MAX];
+    socklen_t  len;
+
+    if (c->pool == NULL || c->listening == NULL || !c->listening->save_syn) {
+        return;
+    }
+
+    len = NGX_TCP_SAVED_SYN_MAX;
+
+    if (getsockopt(c->fd, IPPROTO_TCP, TCP_SAVED_SYN, buf, &len) == -1
+        || len == 0)
+    {
+        return;
+    }
+
+    c->saved_syn.data = ngx_pnalloc(c->pool, len);
+    if (c->saved_syn.data == NULL) {
+        return;
+    }
+
+    ngx_memcpy(c->saved_syn.data, buf, len);
+    c->saved_syn.len = len;
+
+    ngx_log_debug1(NGX_LOG_DEBUG_EVENT, c->log, 0,
+                   "saved SYN headers: %uz bytes", c->saved_syn.len);
+}
+
+#endif
+
+
 void
 ngx_free_connection(ngx_connection_t *c)
 {

