Opt-in TCP_SAVE_SYN / TCP_SAVED_SYN for nginx.

Default off. Enable with:

    tcp_save_syn on;    # http, server, or stream

Accepted connections store the client SYN (IP+TCP headers) in
ngx_connection_t.saved_syn (ngx_str_t) for any module to read.

Apply on vanilla nginx (separate from the JA4 ClientHello patch):

    patch -p1 < patches/nginx-tcp-save-syn.patch

--- a/auto/unix
+++ b/auto/unix
@@ -534,6 +534,26 @@
 . auto/feature
 
 
+ngx_feature="TCP_SAVE_SYN"
+ngx_feature_name="NGX_HAVE_TCP_SAVE_SYN"
+ngx_feature_run=no
+ngx_feature_incs="#include <sys/socket.h>
+                  #include <netinet/in.h>
+                  #include <netinet/tcp.h>"
+ngx_feature_path=
+ngx_feature_libs=
+ngx_feature_test="int  save_syn = 1;
+#ifndef TCP_SAVE_SYN
+#define TCP_SAVE_SYN  27
+#endif
+#ifndef TCP_SAVED_SYN
+#define TCP_SAVED_SYN 28
+#endif
+                  setsockopt(0, IPPROTO_TCP, TCP_SAVE_SYN,
+                             &save_syn, sizeof(int))"
+. auto/feature
+
+
 ngx_feature="accept4()"
 ngx_feature_name="NGX_HAVE_ACCEPT4"
 ngx_feature_run=no

